{% from "components/social-links.njk" import socialLinks %}
{% from "components/brand-logo.njk" import brandLogo %}
{% macro navLink(item, currentUrl) %}
  <a href="{{ item.url }}"{% if currentUrl == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
{% endmacro %}
<header class="site-header" data-header>
  <div class="header-topbar">
    <div class="container container--wide header-topbar-inner">
      <div class="header-contacts" aria-label="Contatos da TW Idiomas">
        <a class="header-contact-link" href="mailto:{{ site.contact.email }}">
          <svg class="header-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <span>{{ site.contact.email }}</span>
        </a>
        <a class="header-contact-link" href="tel:{{ site.contact.phoneHref }}">
          <svg class="header-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7 3h3l1.5 4-2 1.5a15 15 0 0 0 6 6l1.5-2L21 14v3a4 4 0 0 1-4 4C9.3 20.5 3.5 14.7 3 7a4 4 0 0 1 4-4Z"/></svg>
          <span>{{ site.contact.phoneLabel }}</span>
        </a>
      </div>
      <div class="header-socials" aria-label="Redes sociais da TW Idiomas">
        {{ socialLinks(site.instagram, site.linkedin, site.facebook, "header") }}
      </div>
    </div>
  </div>
  <div class="header-mainbar">
    <div class="container container--wide header-inner">
      <a class="brand" href="/" aria-label="TW Idiomas — início">
        {{ brandLogo("brand-logo") }}
      </a>
      <nav class="main-navigation" id="main-navigation" aria-label="Navegação principal" data-mobile-menu>
        {% for item in navigation %}
          {% if item.children %}
            <details class="nav-courses">
              <summary>{{ item.label }} <svg aria-hidden="true" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m3 6 5 5 5-5"/></svg></summary>
              <div class="nav-submenu">
                {% for course in item.children %}{{ navLink(course, page.url) }}{% endfor %}
              </div>
            </details>
          {% else %}
            {{ navLink(item, page.url) }}
          {% endif %}
        {% endfor %}
      </nav>
      <a class="btn btn--outline header-cta" href="/#jornadas">
        <svg class="header-cta-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m2 10 10-5 10 5-10 5L2 10Z"/><path d="M6 12.5V17c3.5 2.5 8.5 2.5 12 0v-4.5"/><path d="M22 10v6"/></svg>
        <span>ENCONTRE SEU CURSO</span>
      </a>
      <button class="nav-toggle" type="button" aria-label="Menu principal" aria-expanded="false" aria-controls="main-navigation" data-menu-toggle>
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
</header>
