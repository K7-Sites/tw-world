<section class="page-hero page-hero--courses" aria-labelledby="page-title">
  <div class="container container--wide page-hero-grid">
    <div class="page-hero-copy">
      <p class="eyebrow">Curso de {{ languageName | lower }}</p>
      <h1 id="page-title">{{ languageName }} <span class="heading-accent">para adultos</span></h1>
      <p class="lead">Curso exclusivo para adultos, com aprendizagem orientada pela Metodologia TW.</p>
      <div class="actions">
        <a class="btn btn--primary" href="#metodologia">CONHEÇA A METODOLOGIA</a>
        <button class="btn btn--outline" type="button" data-journey-contact data-contact-group="adult" data-contact-language="{{ contactLanguage }}">FALE CONOSCO</button>
      </div>
    </div>
    <div class="course-map" data-reveal="load" aria-label="Informações confirmadas do curso de {{ languageName | lower }}">
      <div><span>01</span><strong>Público</strong><small>Adultos</small></div>
      <div><span>02</span><strong>Metodologia</strong><small>Metodologia TW</small></div>
    </div>
  </div>
</section>

<section class="section section--muted" id="metodologia" aria-labelledby="metodologia-title">
  <div class="container container--wide methodology-layout">
    <div class="methodology-intro">
      <p class="eyebrow">Metodologia em ação</p>
      <h2 id="metodologia-title">O idioma vivido em <span class="heading-accent">contextos significativos</span></h2>
      <p class="lead">{{ courseGuide.methodology.intro }}</p>
      <p>{{ courseGuide.methodology.supporting }}</p>
    </div>
    <ol class="principles-list" data-reveal="right" aria-label="Princípios da Metodologia TW">
      {% for principle in courseGuide.methodology.principles %}
        <li><span aria-hidden="true">0{{ loop.index }}</span>{{ principle }}</li>
      {% endfor %}
    </ol>
  </div>
</section>

<section class="section" aria-labelledby="adultos-title">
  <div class="container container--wide learning-band">
    <div>
      <p class="eyebrow">Curso para adultos</p>
      <h2 id="adultos-title">Aprendizagem com <span class="heading-accent">participação e prática</span></h2>
      <p>O curso de {{ languageName | lower }} é exclusivo para adultos e segue os princípios da Metodologia TW.</p>
    </div>
    <ul class="check-list" data-reveal="right">
      {% for principle in courseGuide.methodology.principles %}
        {% if loop.index <= 4 %}<li>{{ principle }}</li>{% endif %}
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section guide-highlight" aria-labelledby="informacoes-title">
  <div class="container container--wide guide-highlight-inner">
    <div>
      <p class="eyebrow">Informações do curso</p>
      <h2 id="informacoes-title">Consulte a equipe TW</h2>
    </div>
    <p>Fale com nossa equipe para conhecer níveis, turmas, horários e unidades disponíveis.</p>
    <button class="btn btn--outline" type="button" data-journey-contact data-contact-group="adult" data-contact-language="{{ contactLanguage }}">FALE CONOSCO</button>
  </div>
</section>
