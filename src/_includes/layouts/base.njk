<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if not seo.allowIndexing or seoIndex == false %}<meta name="robots" content="noindex,nofollow">{% endif %}
  <title>{{ title | escape }} | {{ site.name | escape }}</title>
  <meta name="description" content="{{ description | escape }}">
  <meta name="theme-color" content="#78AC1C">
  {% if seoIndex != false %}
    <link rel="canonical" href="{{ seo.origin }}{{ page.url | escape }}">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="pt_BR">
    <meta property="og:site_name" content="{{ site.name | escape }}">
    <meta property="og:title" content="{{ title | escape }} | {{ site.name | escape }}">
    <meta property="og:description" content="{{ description | escape }}">
    <meta property="og:url" content="{{ seo.origin }}{{ page.url | escape }}">
    <meta property="og:image" content="{{ seo.socialImage | escape }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ site.name | escape }}">
    {% if page.url == "/" %}<script type="application/ld+json">{{ seo.organization | safe }}</script>{% endif %}
  {% endif %}
  <link rel="icon" href="/assets/images/brand/favicon.svg" type="image/svg+xml" sizes="any">
  <link rel="stylesheet" href="/assets/main.css">
  {% if not contactConfirmation %}<script type="module" src="/assets/js/main.js?v=contact-confirmation"></script>{% endif %}
</head>
<body>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  {% if not contactConfirmation %}{% include "components/header.njk" %}{% endif %}
  <main id="conteudo" tabindex="-1"{% if courseLanguage %} data-lang="{{ courseLanguage }}"{% endif %}>
    {{ content | safe }}
    {% if not contactConfirmation %}{% include "components/site-contact.njk" %}{% endif %}
  </main>
  {% if not contactConfirmation %}{% include "components/footer.njk" %}{% endif %}
</body>
</html>
