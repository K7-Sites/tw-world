---
layout: layouts/base.njk
permalink: /index.html
title: Idiomas para aprender de verdade
description: Conheça a TW Idiomas, seus programas de inglês, francês e espanhol e a experiência de aprendizagem.
---
{% from "components/ui.njk" import button, placeholder %}
{% from "components/home-media.njk" import journeyArt, invitePlayer, location, heroVideoDialog %}
{% from "components/school-hero-image.njk" import schoolHeroImage %}
<div class="tw-home">
<section class="hero section" aria-labelledby="hero-title">
  <div class="hero-backdrop" aria-hidden="true"><div class="hero-shapes" data-hero-parallax></div></div>
  <div class="container container--wide hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">
        <svg class="hero-eyebrow-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m2 10 10-5 10 5-10 5L2 10Z"/><path d="M6 12.5V17c3.5 2.5 8.5 2.5 12 0v-4.5"/><path d="M22 10v6"/></svg>
        <span>TW Idiomas · Transworld Idiomas</span>
      </p>
      <h1 id="hero-title" class="hero-enter">Idiomas para aprender <span class="heading-accent">de verdade.</span></h1>
      <p class="lead hero-enter">Inglês, francês e espanhol, a partir dos 4 anos.</p>
      <div class="actions hero-enter">
        {{ button("ENCONTRE SEU CURSO", "#jornadas", "primary", true) }}
        {% if heroVideo %}
          <a class="btn btn--outline hero-video-trigger" href="{{ heroVideo.desktop }}" data-hero-video data-mobile="{{ heroVideo.mobile }}"><svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" d="M12 1a11 11 0 1 0 0 22 11 11 0 1 0 0-22ZM9 7v10l8-5z"/></svg>CONHEÇA A TW</a>
        {% else %}
          {{ button("CONHEÇA A TW", "#a-tw", "outline") }}
        {% endif %}
      </div>
      <ul class="hero-journeys hero-flags" aria-label="Idiomas oferecidos">
        <li class="hero-journey">
          <img src="/assets/images/flags/english-united-kingdom.svg" alt="Inglês" width="1200" height="600">
        </li>
        <li class="hero-journey">
          <img src="/assets/images/flags/french-france.svg" alt="Francês" width="900" height="600">
        </li>
        <li class="hero-journey">
          <img src="/assets/images/flags/spanish-spain.svg" alt="Espanhol" width="900" height="600">
        </li>
      </ul>
    </div>
    <div class="hero-media hero-enter">
      {{ schoolHeroImage("Crianças e teacher da TW Idiomas em sala de aula.", "hero-image") }}
      <div class="hero-bubbles" aria-hidden="true">
        <span class="hero-bubble hero-enter" data-lang="en" lang="en">Hello!</span>
        <span class="hero-bubble hero-enter" data-lang="fr" lang="fr">Bonjour !</span>
        <span class="hero-bubble hero-enter" data-lang="es" lang="es">¡Hola!</span>
      </div>
      <div class="hero-identity-card">
        <span class="hero-identity-mark" aria-hidden="true">TW</span>
        <span><strong>TW Idiomas</strong><small>Transworld Idiomas</small></span>
      </div>
    </div>
  </div>
  {% if heroVideo %}{{ heroVideoDialog() }}{% endif %}
</section>
<section class="section" id="a-tw" aria-labelledby="historia-title"><div class="container split school-layout">
  <div class="school-carousel" data-carousel data-reveal data-reveal-anchor="top-center" role="region" aria-roledescription="carrossel" aria-label="Imagens da TW Idiomas">
    <div class="school-carousel-viewport">
      <div class="school-carousel-track" data-carousel-track>
        <figure class="school-carousel-slide" data-carousel-slide>
          <img src="/assets/images/school/espaco-cultura-tw-world-05.webp" alt="Espaço de leitura e estudo da TW Idiomas com livros e mesas." width="1242" height="932" loading="lazy" decoding="async">
        </figure>
        <figure class="school-carousel-slide" data-carousel-slide>
          <img src="/assets/images/school/espaco-escola-tw-world-01.webp" alt="Auditório da TW Idiomas com palco e cadeiras." width="1242" height="932" loading="lazy" decoding="async">
        </figure>
        <figure class="school-carousel-slide" data-carousel-slide>
          <img src="/assets/images/school/espaco-kids-tw-world-02.webp" alt="Sala infantil da TW Idiomas com mesas coloridas e lousa interativa." width="1242" height="932" loading="lazy" decoding="async">
        </figure>
        <figure class="school-carousel-slide" data-carousel-slide>
          <img src="/assets/images/school/curso-ingles-tw-world.webp" alt="Aluno e teacher durante uma atividade em sala de aula na TW Idiomas." width="1242" height="932" loading="lazy" decoding="async">
        </figure>
        <figure class="school-carousel-slide" data-carousel-slide>
          <img src="/assets/images/hero/image-12.webp" alt="Turma de crianças com a teacher da TW Idiomas." width="1448" height="1086" loading="lazy" decoding="async">
        </figure>
        <figure class="school-carousel-slide" data-carousel-slide>
          <img src="/assets/images/hero/image-13.webp" alt="Turma de crianças com a teacher da TW Idiomas." width="1448" height="1086" loading="lazy" decoding="async">
        </figure>
        <figure class="school-carousel-slide" data-carousel-slide>
          <img src="/assets/images/hero/image-14.webp" alt="Turma de crianças com a teacher da TW Idiomas." width="1448" height="1086" loading="lazy" decoding="async">
        </figure>
        <figure class="school-carousel-slide" data-carousel-slide>
          <img src="/assets/images/hero/image-15.webp" alt="Turma de crianças com a teacher da TW Idiomas." width="1448" height="1086" loading="lazy" decoding="async">
        </figure>
        <figure class="school-carousel-slide" data-carousel-slide>
          <img src="/assets/images/school/espaco-jogos-tw-world-03.webp" alt="Espaço de jogos da TW Idiomas com mesas de pingue-pongue, aero hockey e pebolim." width="1242" height="932" loading="lazy" decoding="async">
        </figure>
        <figure class="school-carousel-slide" data-carousel-slide>
          <img src="/assets/images/school/espaco-kids-jogos-tw-world-04.webp" alt="Espaço infantil da TW Idiomas preparado para jogos e atividades." width="1242" height="932" loading="lazy" decoding="async">
        </figure>
      </div>
    </div>
    <div class="school-carousel-controls" role="group" aria-label="Navegação das fotos">
      <button class="school-carousel-button" type="button" data-carousel-previous aria-label="Imagem anterior">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <span class="school-carousel-status" data-carousel-status aria-live="polite">1 / 10</span>
      <button class="school-carousel-button" type="button" data-carousel-next aria-label="Próxima imagem">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  </div>
  <div class="school-content">
    <p class="eyebrow">A escola</p>
    <h2 id="historia-title">Transworld Idiomas e <em class="heading-accent">TW Idiomas</em></h2>
    <p data-reveal>{{ courseGuide.about[0] }}</p>
    <p data-reveal>{{ courseGuide.brandTransition }}</p>
    <div class="school-values" data-reveal-group>
      <article class="school-value-card info-card" data-reveal>
        <svg class="school-value-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r="1"/>
        </svg>
        <h3>Missão</h3>
        <p>{{ courseGuide.mission }}</p>
      </article>
      <article class="school-value-card info-card" data-reveal>
        <svg class="school-value-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/>
        </svg>
        <h3>Visão</h3>
        <p>{{ courseGuide.vision }}</p>
      </article>
    </div>
    {{ button("Conheça a TW", "/a-tw/", "outline") }}
  </div>
</div></section>
<section class="section lesson" aria-labelledby="alem-title">
  <div class="container editorial-pair">
    <div>
      <p class="eyebrow">Muito além da aula</p>
      <h2 id="alem-title">Prática, acompanhamento e <span class="heading-accent">experiências</span></h2>
      <p data-reveal>{{ courseGuide.methodology.supporting }}</p>
    </div>
    <ol class="lesson-list" data-reveal-group>
      {% for item in courseGuide.differentials %}
        <li data-reveal>
          <span class="lesson-index" aria-hidden="true">0{{ loop.index }}</span>
          <div><h3>{{ item.title }}</h3><p>{{ item.text }}</p></div>
        </li>
      {% endfor %}
    </ol>
  </div>
</section>

<section class="section" id="jornadas" aria-labelledby="jornadas-title">
  <div class="container container--wide">
    <p class="eyebrow">Jornadas</p>
    <h2 id="jornadas-title">Jornadas de <span class="heading-accent">aprendizagem</span></h2>
    <div class="journey-shelf" data-reveal-group data-reveal-anchor="top-center">
      {% for journey in journeys %}
        <article class="journey-edition" data-reveal>
          {{ journeyArt(journey, loop.index) }}
          <div class="card-content">
            <p class="card-kicker">{{ journey.age }}</p>
            <h3>{{ journey.name }}</h3>
            <p>{{ journey.summary }}</p>
            <a class="journey-contact-link" href="/contato/" data-journey-contact{% if journey.contactGroup %} data-contact-group="{{ journey.contactGroup }}"{% endif %}>Saiba mais<span class="sr-only"> sobre {{ journey.name }}</span></a>
          </div>
        </article>
      {% endfor %}
    </div>
    <div class="actions" data-reveal>{{ button("Inglês", "/ingles/", "outline") }} {{ button("Francês", "/frances/", "outline") }} {{ button("Espanhol", "/espanhol/", "outline") }}</div>
  </div>
</section>

<section class="section exam-band" aria-labelledby="cert-title">
  <div class="container editorial-pair">
    <div>
      <p class="eyebrow">Preparação internacional</p>
      <h2 id="cert-title">Preparação para <span class="heading-accent">exames internacionais</span></h2>
    </div>
    <div>
      <dl class="exam-list" data-reveal-group>
        {% for journey in journeys %}{% if journey.exam %}
          <div data-reveal><dt>{{ journey.name }}</dt><dd>Preparação para <strong>{{ journey.exam }}</strong>.</dd></div>
        {% endif %}{% endfor %}
      </dl>
      <p class="exam-note" data-reveal>A preparação não representa certificação automática.</p>
    </div>
  </div>
</section>

<section class="section" aria-labelledby="convite-title">
  <div class="container editorial-pair">
    <div>
      <p class="eyebrow">Convite da direção</p>
      <h2 id="convite-title">Um convite para <span class="heading-accent">conhecer a TW</span></h2>
      {% if not heroVideo %}
        <p>Vídeo-convite da Janaína, com legendas e transcrição.</p>
      {% endif %}
    </div>
    {{ invitePlayer(heroVideo or invite) }}
  </div>
</section>

<section class="section experience-home" aria-labelledby="experiencia-title">
  <div class="container">
    <div class="section-heading">
      <div><p class="eyebrow">Experiência TW</p><h2 id="experiencia-title">Aprendizado durante <span class="heading-accent">toda a semana</span></h2></div>
      <p data-reveal>Estrutura pedagógica para oferecer continuidade, acompanhamento próximo e experiências que fortalecem o desenvolvimento do aluno.</p>
    </div>
    <div class="experience-path" data-reveal-group>
      <article class="trail-feature" data-reveal><h3>{{ courseGuide.trail.title }}</h3><p>{{ courseGuide.trail.text }}</p></article>
      <div class="trail-stops">
        {% for service in [courseGuide.support[2], courseGuide.support[3]] %}
          <article data-reveal><h3>{{ service.name }}</h3><p>{{ service.text }}</p></article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section class="section section--compact" aria-labelledby="intercambio-title">
  <div class="container editorial-pair exchange-note">
    <div>
      <p class="eyebrow">O idioma abre caminhos</p>
      <h2 id="intercambio-title">Oportunidades de <span class="heading-accent">intercâmbio</span></h2>
      <p data-reveal>Acesso e facilitação por meio de parcerias internacionais.</p>
    </div>
    <img src="/assets/images/sections/oportunidades-de-intercambio.webp" alt="Duas mulheres observam um globo terrestre ao lado de uma mala de viagem." width="1600" height="900" loading="lazy" decoding="async" data-reveal data-reveal-anchor="top-center">
  </div>
</section>

<section class="section locations-home" aria-labelledby="local-title">
  <div class="container editorial-pair">
    <div><p class="eyebrow">Onde estamos</p><h2 id="local-title">Onde <span class="heading-accent">estamos</span></h2></div>
    <div class="location-index" data-reveal-group>
      {{ location("Boa Vista", "Unidade Central", locations.boaVista) }}
      {{ location("CIC", "Núcleo Educacional", locations.cic) }}
    </div>
  </div>
</section>

<section class="section home-close" aria-labelledby="prova-title">
  <div class="container container--wide">
    {% include "components/reviews.njk" %}
    {{ button("Conheça nossos canais", "/contato/", "outline") }}
  </div>
</section>
</div>
